# NEXVORA Technologies — Environment Configuration
# Copy this file to .env.local for local development.

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="https://nexvora.com"

# Email Delivery (Resend API)
# Get your API key at https://resend.com
RESEND_API_KEY=""
CONTACT_RECEIVER_EMAIL="nexvora.code@gmail.com"
EMAIL_FROM="NEXVORA Technologies <notifications@nexvora.com>"

# Cloudflare Turnstile Spam & Bot Protection
# Get your keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Analytics (Optional: Plausible / GA4)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="nexvora.com"

# Serverless Distributed Rate Limiting (Upstash Redis or Vercel KV)
# Get keys at https://upstash.com or via Vercel Storage tab
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Or Vercel KV aliases:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""


